+    fn tar_octal(header: &mut [u8], value: u64) -> io::Result<()> {
+        let digits = format!("{value:o}");
+        if digits.len() >= header.len() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "MTD size exceeds tar format",
+            ));
+        }
+        header.fill(b'0');
+        let start = header.len() - 1 - digits.len();
+        header[start..start + digits.len()].copy_from_slice(digits.as_bytes());
+        header[header.len() - 1] = 0;
+        Ok(())
+    }
+
+    fn tar_header(name: &str, size: u64) -> io::Result<[u8; 512]> {
+        if name.len() > 100 || !name.is_ascii() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "Invalid tar filename",
+            ));
+        }
+        let mut header = [0u8; 512];
+        header[..name.len()].copy_from_slice(name.as_bytes());
+        tar_octal(&mut header[100..108], 0o644)?;
+        tar_octal(&mut header[108..116], 0)?;
+        tar_octal(&mut header[116..124], 0)?;
+        tar_octal(&mut header[124..136], size)?;
+        tar_octal(&mut header[136..148], 0)?;
+        header[148..156].fill(b' ');
+        header[156] = b'0';
+        header[257..263].copy_from_slice(b"ustar\0");
+        header[263..265].copy_from_slice(b"00");
+        let checksum: u64 = header.iter().map(|byte| u64::from(*byte)).sum();
+        let text = format!("{checksum:06o}\0 ");
+        header[148..156].copy_from_slice(text.as_bytes());
+        Ok(header)
+    }
+
+    fn tar_entry_size(size: u64) -> Option<u64> {
+        size.checked_add(511)?
+            .checked_div(512)?
+            .checked_mul(512)?
+            .checked_add(512)
+    }
