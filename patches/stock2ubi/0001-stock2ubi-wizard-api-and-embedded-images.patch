+    async fn tar_file<W: AsyncWriteExt + Unpin>(
+        output: &mut W,
+        name: &str,
+        size: u64,
+        input: &mut tokio::fs::File,
+    ) -> io::Result<()> {
+        output.write_all(&tar_header(name, size)?).await?;
+        let copied = tokio::io::copy(&mut input.take(size), output).await?;
+        if copied != size {
+            return Err(io::Error::new(
+                io::ErrorKind::UnexpectedEof,
+                "MTD backup ended early",
+            ));
+        }
+        let padding = (512 - size % 512) % 512;
+        output.write_all(&[0u8; 512][..padding as usize]).await?;
+        Ok(())
+    }
